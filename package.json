{
  "name": "pocketdump",
  "version": "0.11.3",
  "description": "Transfer photos, videos and files between iPhone and PC over local WiFi (or USB)",
  "author": "Alex Kim",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "multer": "^2.0.0",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.3",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.15.2",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "com.alexkim.pocketdump",
    "productName": "PocketDump",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "alxkim97",
      "repo": "pocketdump",
      "releaseType": "release"
    }
  }
}
